# Private Image Registry Configuration
# Copy this file to .env and configure for your environment

# Registry URL (without https://)
REGISTRY_URL=your-registry.example.com

# Registry project/namespace for freedom-sentry
REGISTRY_PROJECT=freedom-sentry

# Ops Repository Configuration
# Path to the ops repository containing deployment configuration
OPS_REPO_PATH=/path/to/ops/repo

# Relative path within ops repo to the values.yaml file
OPS_VALUES_FILE=path/to/freedom-sentry/values.yaml
